{
  "name": "@lenterra/verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Auth verifier sidecar (ADR-004). Verifies thirdweb RS256 JWTs and mints short-lived HS256 assertions Nakama can check with nk.hmacSha256Hash.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "test": "node --test test/"
  },
  "dependencies": {
    "express": "^4.21.1",
    "thirdweb": "^5.105.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
