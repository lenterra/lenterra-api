{
  "name": "lenterra-api",
  "private": true,
  "version": "0.1.0",
  "description": "Lenterra backend: shared rules core, Nakama TypeScript runtime modules, and the auth verifier sidecar.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "modules",
    "verifier"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "guard:deps": "node scripts/deps-guard.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:schema": "node --test test/schema.test.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "content:publish": "node scripts/content-publish.mjs",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "build": "npm run build -w @lenterra/core && npm run build -w @lenterra/modules",
    "build:core": "npm run build -w @lenterra/core",
    "build:modules": "npm run build -w @lenterra/modules",
    "guard:bundle": "node scripts/bundle-guard.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "docker compose -f docker/docker-compose.yml down",
    "dev:logs": "docker compose -f docker/docker-compose.yml logs -f nakama",
    "dev:reload": "npm run build:modules && npm run guard:bundle && docker compose -f docker/docker-compose.yml restart nakama",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prod:logs": "docker compose -f docker/docker-compose.prod.yml logs -f",
    "prod:down": "docker compose -f docker/docker-compose.prod.yml down",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "test:contract": "node --import ./test/ts-resolve.mjs --test \"test/*.test.mts\"",
    "test:content": "node --test test/rewards.test.mjs",
    "fixtures:generate": "node scripts/fixtures-generate.mjs",
    "test:conformance": "node --test test/conformance.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "js-yaml": "^5.3.0",
    "pg": "^8.13.1",
    "typescript": "^5.6.3"
  }
}
