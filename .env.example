# Lenterra backend environment. Copy to .env and fill in.
# No real secret is ever committed (20-02 "Configuration").

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Nakama ---------------------------------------------------------------
# Never 'defaultkey' outside a throwaway local stack. The demo client
# hardcoded that value (lib/nakama-client.ts:3); the target client reads it
# from configuration.
NAKAMA_SERVER_KEY=lenterra-localdev-key
NAKAMA_HTTP_KEY=lenterra-localdev-http
NAKAMA_HOST=localhost
NAKAMA_PORT=7350

# --- Auth (ADR-004) -------------------------------------------------------
# Shared by the verifier and the Nakama modules, and by nothing else.
# Rotation accepts two keys at once: set ASSERTION_HMAC_SECRET_PREVIOUS
# during the window, then drop it (20-14).
ASSERTION_HMAC_SECRET=change-me-32-bytes-minimum-localdev-only
ASSERTION_HMAC_SECRET_PREVIOUS=

# thirdweb server credential for the verifier. NOT the public client id.
THIRDWEB_SECRET_KEY=
AUTH_DOMAIN=localhost:8787

# Join grants for class-code onboarding (TRD-AUTH-004)
JOIN_GRANT_HMAC_SECRET=change-me-join-grant-localdev-only

VERIFIER_PORT=8787
VERIFIER_URL=http://localhost:8787
