# Production environment. Copy to docker/.env.prod on the server and fill in.
#
# **Nothing here has a default.** The production compose file uses `${VAR:?}`,
# so a missing value stops the stack from starting rather than silently running
# on a placeholder from a public repository — which is how a development
# password ends up in front of children's records.
#
# This file is committed; `.env.prod` is not. Generate every secret on the
# server, not on a laptop:
#
#     openssl rand -hex 32

# --- The public name ------------------------------------------------------
LENTERRA_API_DOMAIN=lenterra-api.faizath.com
# Where Let's Encrypt sends expiry warnings. Use a mailbox somebody reads: a
# lapsed certificate takes every classroom offline at once.
ACME_EMAIL=

# --- Postgres -------------------------------------------------------------
# Never published to the host. This password guards the database from inside
# the compose network only, which is not a reason to make it weak.
POSTGRES_DB=nakama
POSTGRES_USER=lenterra
POSTGRES_PASSWORD=

# --- Nakama ---------------------------------------------------------------
# Identifies the client application. Every client holds it and it authorises
# nothing — the session token does that — but it must not be Nakama's published
# `defaultkey`, and it must match what the app and dashboard are built with.
NAKAMA_SERVER_KEY=lenterra

# Server-side only. The verifier uses it to reach an unauthenticated RPC; no
# client ever sees it, which is why the class-code hop runs on the server.
NAKAMA_HTTP_KEY=

# The console is not exposed, but it authenticates anyway — an SSH tunnel is
# not an authorisation.
NAKAMA_CONSOLE_USER=
NAKAMA_CONSOLE_PASSWORD=

# --- Auth (ADR-004) -------------------------------------------------------
# Shared by the verifier and the Nakama modules, and by nothing else. At least
# 32 characters; the verifier refuses to start below that.
#
# Rotation accepts two at once: set _PREVIOUS to the outgoing value for the
# window, then clear it. Replacing without it fails every sign-in in flight.
ASSERTION_HMAC_SECRET=
ASSERTION_HMAC_SECRET_PREVIOUS=

# Signs the grants Nakama mints for class and staff codes. The verifier checks
# them with the same key, so a mismatch rejects every code sign-in.
JOIN_GRANT_HMAC_SECRET=

# --- Optional -------------------------------------------------------------
# Only the "connect a wallet" path needs thirdweb. Left empty, those endpoints
# answer 503 and everything else — joining, playing, syncing, certificates —
# works normally.
THIRDWEB_SECRET_KEY=
AUTH_DOMAIN=lenterra-api.faizath.com

# When the daily retention run fires, as an hour in UTC. 19:00 UTC is 03:00
# WITA — nobody's lesson. Deleting an account is irreversible and the sweep
# walks every due row, so it should not run while a classroom is on the server.
PURGE_HOUR_UTC=19
